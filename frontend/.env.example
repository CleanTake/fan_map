# Map display requires a public Mapbox access token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional. Defaults to frontend/.data/auth.sqlite when running from frontend.
# FANMAP_AUTH_DB=.data/auth.sqlite

# Optional canonical public origin, recommended behind an HTTPS reverse proxy.
# FANMAP_AUTH_ORIGIN=https://fanmap.example.com

