# Map display requires a public Mapbox access token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: comma-separated computer IPs/hostnames used for phone development.
# Hostnames only, without http:// or a port; restart the dev server after changes.
# FANMAP_DEV_ORIGINS=172.20.10.2

# Optional. Defaults to frontend/.data/auth.sqlite when running from frontend.
# FANMAP_AUTH_DB=.data/auth.sqlite

# Optional canonical public origin, recommended behind an HTTPS reverse proxy.
# FANMAP_AUTH_ORIGIN=https://fanmap.example.com

## this method allows you to make your account and admin 

## Steps

## create an account

## run the following in your terminal

# npm run auth:admin -- youraccount@gmail.com
